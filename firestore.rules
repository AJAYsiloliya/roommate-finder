rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      allow read: if request.auth != null;

      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }


    // =========================
    // CHATS
    // =========================
    match /chats/{chatId} {

      // Check block in either direction
      function isBlocked(userA, userB) {
        return exists(
          /databases/$(database)/documents/blocks/$(userA + "_" + userB)
        )
        ||
        exists(
          /databases/$(database)/documents/blocks/$(userB + "_" + userA)
        );
      }


      // CREATE CHAT
      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0]
          != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && !isBlocked(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );


      // READ CHAT
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;


      // UPDATE CHAT
      allow update: if request.auth != null
        && resource.data.participants.size() == 2
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants
          == resource.data.participants
        && !isBlocked(
          resource.data.participants[0],
          resource.data.participants[1]
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessage",
            "updatedAt",
            "unreadFor",
            "hiddenFor"
          ]);


      // DELETE CHAT
      allow delete: if request.auth != null
        && resource.data.participants.size() == 2
        && request.auth.uid in resource.data.participants
        && !isBlocked(
          resource.data.participants[0],
          resource.data.participants[1]
        );


      // =========================
      // MESSAGES
      // =========================
      match /messages/{messageId} {

        // READ MESSAGE
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants.size() == 2
          && !isBlocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[0],
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[1]
          );


        // CREATE MESSAGE
        allow create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && request.resource.data.senderId == request.auth.uid
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants.size() == 2
          && !isBlocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[0],
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[1]
          );


        // UPDATE MESSAGE
        // Only readBy can be changed
        allow update: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants.size() == 2
          && !isBlocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[0],
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[1]
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["readBy"]);


        // DELETE MESSAGE
        // Only sender can delete
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.senderId
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && !isBlocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[0],
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants[1]
          );
      }
    }


    // =========================
    // CONTACT
    // =========================
    match /contacts/{contactId} {

      allow create: if true;

      allow read, update, delete: if false;
    }


    // =========================
    // REPORTS
    // =========================
    match /reports/{reportId} {

      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid;

      allow read, update, delete: if false;
    }


    // =========================
    // BLOCKS
    // =========================
    match /blocks/{blockId} {

      allow create: if request.auth != null
        && request.resource.data.blockedBy == request.auth.uid
        && request.resource.data.blockedUserId != request.auth.uid;

      allow read, delete: if request.auth != null
        && resource.data.blockedBy == request.auth.uid;

      allow update: if false;
    }


    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {

      // User can read only their own notifications
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // User can only change read status
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read"]);

      // Notifications are created by trusted backend only
      allow create: if false;

      // Users cannot delete notifications
      allow delete: if false;
    }


    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}